{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/2.0/crates/tauri-cli/schema.json",
  "productName": "SentinelX",
  "version": "0.4.0",
  "identifier": "com.sentinelx.desktop",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SentinelX - Defensive Threat Detection & Monitoring",
        "width": 1366,
        "height": 868,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
